<!DOCTYPE html>
<html lang="my">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ဖိတ်စာနှင့် ဆုတောင်းလွှာ App</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: sans-serif;
        }
        body {
            background-color: #f4f6f9;
            display: flex;
            justify-content: center;
        }
        .app-container {
            width: 100%;
            max-width: 420px;
            background: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        .header {
            background: linear-gradient(135deg, #4e54c8, #8f94fb);
            color: white;
            padding: 24px 20px;
            text-align: center;
            border-bottom-left-radius: 20px;
            border-bottom-right-radius: 20px;
        }
        .header h1 {
            font-size: 20px;
            margin-bottom: 6px;
        }
        .header p {
            font-size: 12px;
            opacity: 0.9;
        }
        .content {
            padding: 20px;
            flex: 1;
        }
        .screen {
            display: none;
        }
        .screen.active {
            display: block;
        }
        /* Intro Menu Cards */
        .menu-card {
            background: #fff;
            border: 2px solid #eef2f5;
            border-radius: 14px;
            padding: 18px;
            margin-bottom: 15px;
            cursor: pointer;
            transition: 0.2s;
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .menu-card:active {
            transform: scale(0.98);
            border-color: #4e54c8;
            background-color: #f8f9fa;
        }
        .icon {
            font-size: 28px;
        }
        .menu-info h3 {
            font-size: 16px;
            color: #333;
            margin-bottom: 4px;
        }
        .menu-info p {
            font-size: 12px;
            color: #666;
        }
        /* Common Form Elements */
        .btn-back {
            background: #e0e0e0;
            color: #333;
            border: none;
            padding: 8px 14px;
            border-radius: 6px;
            font-size: 13px;
            margin-bottom: 15px;
            cursor: pointer;
        }
        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            display: block;
            font-size: 13px;
            margin-bottom: 6px;
            font-weight: bold;
            color: #444;
        }
        .form-group input, .form-group textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 14px;
        }
        .btn-submit {
            width: 100%;
            background: #4e54c8;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
        }
    </style>
</head>
<body>

<div class="app-container">
    <!-- Header -->
    <div class="header">
        <h1 id="app-title">ဒီဂျစ်တယ် ဖိတ်စာနှင့် ဆုတောင်းလွှာ</h1>
        <p>လွယ်ကူလျင်မြန်စွာ ဖန်တီးပြီး မျှဝေပါ</p>
    </div>

    <!-- Main Content Area -->
    <div class="content">

        <!-- 1. Intro Screen (Menu Options) -->
        <div id="intro-screen" class="screen active">
            <div class="menu-card" onclick="navigateTo('invitation-screen', 'ဖိတ်စာပြုလုပ်ရန်')">
                <div class="icon">✉️</div>
                <div class="menu-info">
                    <h3>ဖိတ်စာပြုလုပ်ရန်</h3>
                    <div class="p">မင်္ဂလာဆောင်၊ အလှူ၊ ပွဲလမ်းသဘင် ဖိတ်စာများ</div>
                </div>
            </div>

            <div class="menu-card" onclick="navigateTo('wishes-screen', 'ဂုဏ်ပြုဆုတောင်းရန်')">
                <div class="icon">🎂</div>
                <div class="menu-info">
                    <h3>ဂုဏ်ပြုဆုတောင်းရန်</h3>
                    <div class="p">မွေးနေ့၊ အောင်မြင်မှုနှင့် ဂုဏ်ပြုဆုတောင်းလွှာများ</div>
                </div>
            </div>
        </div>

        <!-- 2. Invitation Screen (Placeholder) -->
        <div id="invitation-screen" class="screen">
            <button class="btn-back" onclick="navigateTo('intro-screen', 'ဒီဂျစ်တယ် ဖိတ်စာနှင့် ဆုတောင်းလွှာ')">← နောက်သို့</button>
            <form onsubmit="event.preventDefault(); alert('ဖိတ်စာအချက်အလက်များ သိမ်းဆည်းပြီးပါပြီ။');">
                <div class="form-group">
                    <label>ပွဲအမျိုးအစား</label>
                    <input type="text" placeholder="ဥပမာ- မင်္ဂလာဧည့်ခံပွဲ">
                </div>
                <div class="form-group">
                    <label>ဖိတ်ကြားသူ အမည်</label>
                    <input type="text" placeholder="အမည် ရိုက်ထည့်ပါ">
                </div>
                <div class="form-group">
                    <label>ရက်စွဲ နှင့် အချိန်</label>
                    <input type="datetime-local">
                </div>
                <div class="form-group">
                    <label>ကျင်းပမည့် နေရာ</label>
                    <textarea rows="3" placeholder="နေရာ လိပ်စာ ရိုက်ထည့်ပါ"></textarea>
                </div>
                <button type="submit" class="btn-submit">ဖိတ်စာဒီဇိုင်း ကြည့်မည်</button>
            </form>
        </div>

        <!-- 3. Birthday / Wishes Screen (Placeholder) -->
        <div id="wishes-screen" class="screen">
            <button class="btn-back" onclick="navigateTo('intro-screen', 'ဒီဂျစ်တယ် ဖိတ်စာနှင့် ဆုတောင်းလွှာ')">← နောက်သို့</button>
            <form onsubmit="event.preventDefault(); alert('ဆုတောင်းလွှာ ပြင်ဆင်ပြီးပါပြီ။');">
                <div class="form-group">
                    <label>ဆုတောင်းပေးမည့်သူ အမည်</label>
                    <input type="text" placeholder="ဥပမာ- ကိုကို">
                </div>
                <div class="form-group">
                    <label>ဆုတောင်းစာလွှာ</label>
                    <textarea rows="4" placeholder="ပျော်ရွှင်ဖွယ် မွေးနေ့ဖြစ်ပါစေ..."></textarea>
                </div>
                <button type="submit" class="btn-submit">ဆုတောင်းလွှာ ထုတ်ယူမည်</button>
            </form>
        </div>

    </div>
</div>

<script>
    function navigateTo(screenId, title) {
        // Hide all screens
        const screens = document.querySelectorAll('.screen');
        screens.forEach(s => s.classList.remove('active'));

        // Show targeted screen
        document.getElementById(screenId).classList.add('active');

        // Update header title
        document.getElementById('app-title').innerText = title;
    }
</script>

</body>
</html>
